# Copy to terraform.tfvars (not committed). Nothing here is secret, but the account ID stays out of the repository.
environment    = "prod"
aws_profile    = "<your NASA AWS CLI profile>"
aws_account_id = "<12-digit NASA account ID>" # Terraform refuses to run against any other account
region         = "us-east-1"

api_domain  = "api.nasaroutes.com" # the default. A test name such as api-new.nasaroutes.com is only for a trial before cutover
# existing_eip_allocation_id = "eipalloc-..." # adopt the Elastic IP that api_domain already points at (see docs/journal/2026-11-24-adopt-api-elastic-ip.md). Once adopted, keep it set: dropping it makes the plan fail on purpose
acme_email  = "<Let's Encrypt contact>"
alert_email = "<receives alarms and the budget alert>"

# Sized by the load test (docs/infra/loadtest/README.md#results)
enable_alb         = false
enable_nat_gateway = false
architecture       = "arm64"
instance_type      = "t4g.micro"
cpu_credits        = "unlimited" # keep: in standard mode a micro with no credits left is too slow for the weekly upload
app_single_az      = true        # same Availability Zone as the database
asg_min            = 1
asg_desired        = 1
asg_max            = 1
# The weekly upload of the biggest file needs about 640 MB of Node heap with today's code (docs/journal/2026-11-25-weekly-upload-read-once.md).
# Swap makes a memory squeeze slow the upload down instead of crashing the service. Remove both lines once the upload no longer needs it.
swap_mb      = 2048
node_heap_mb = 768

monthly_budget_usd = 50
