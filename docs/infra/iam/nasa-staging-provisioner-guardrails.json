{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverRemoveOrChangeTheBoundaryOrTrust",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AttachOnlySsmCore",
      "Effect": "Deny",
      "Action": "iam:AttachRolePolicy",
      "Resource": "*",
      "Condition": {
        "ArnNotEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "NeverCopyOrDeriveFromExistingResources",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateImage",
        "ec2:CopyImage",
        "ec2:RegisterImage",
        "ec2:CreateSnapshot",
        "ec2:CreateSnapshots",
        "ec2:CopySnapshot",
        "ec2:CreateVolume",
        "ec2:AttachVolume",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifySnapshotAttribute",
        "ec2:ModifyImageAttribute",
        "ec2:CreateStoreImageTask",
        "ec2:ExportImage",
        "ec2:CreateInstanceExportTask",
        "ec2:GetConsoleScreenshot",
        "ec2:CreateReplaceRootVolumeTask"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BootOnlyAmazonImages",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:*:snapshot/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "ec2:Owner": "amazon"
        }
      }
    },
    {
      "Sid": "NeverTouchResourcesNotTaggedStaging",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:DeleteSecurityGroup",
        "ec2:ModifyVolume",
        "ec2:DeleteVolume"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Environment": "staging"
        }
      }
    },
    {
      "Sid": "NeverRetagSomethingThatIsNotStaging",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Environment": "staging"
        },
        "Null": {
          "aws:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "EnvironmentTagOnlyWhileCreating",
      "Effect": "Deny",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "Project"
          ]
        },
        "StringNotEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup",
            "AllocateAddress",
            "CreateLaunchTemplate",
            "CreateVpc",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateInternetGateway",
            "CreateNetworkAcl",
            "CreateVpcEndpoint",
            "CreateNatGateway",
            "CreateFlowLogs"
          ]
        }
      }
    },
    {
      "Sid": "EnvironmentTagCanOnlyBeStaging",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:RunInstances",
        "ec2:CreateSecurityGroup",
        "ec2:AllocateAddress",
        "ec2:CreateLaunchTemplate",
        "rds:CreateDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Environment"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Sid": "NeverRemoveTheEnvironmentTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Environment"
          ]
        }
      }
    }
  ]
}