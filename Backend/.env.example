# Names of the settings the backend reads. Copy this file to `.env` and fill in the values.
# Never commit a real `.env`, and never put real values in this file.

PORT=
NODE_ENV=
FRONTEND_URL=

# What the logger prints: error, warn, info or debug. Default: info in production, debug elsewhere.
LOG_LEVEL=

# Number of proxies in front of the app: 0 if none, 1 behind a single hosting proxy.
# REQUIRED in production (the server will not start without a whole number). Login limits use the client
# address, which is only correct when this matches reality.
TRUST_PROXY=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# Redis (keeps the list of revoked sign-in tokens)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Sign-in tokens. Use two DIFFERENT long random values.
# The server will not start if either is missing or if they are the same.
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Cloudinary (access code images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications (the mobile app). Nothing is sent unless PUSH_NOTIFICATIONS_ENABLED is exactly "true".
PUSH_NOTIFICATIONS_ENABLED=
# Only if "enhanced push security" is turned on for the Expo project. Leave empty otherwise.
EXPO_ACCESS_TOKEN=
# Tests and staging only. Leave empty to use Expo's push service.
EXPO_PUSH_API_URL=

# Everee (payments, issue #31). Use the SANDBOX token and tenant ID while testing. Everee has one web address for sandbox and
# production: the token and tenant ID decide which one is used, and they must belong to the same instance.
# Sandbox tokens start with tsk_test_, production tokens with tsk_prod_. A production token is refused unless
# EVEREE_ENVIRONMENT is "production". The token is a secret: only in the real .env, never in the repository, a log or a chat.
EVEREE_ENVIRONMENT=…
EVEREE_API_TOKEN=…
EVEREE_TENANT_ID=…
# Sending a payment to Everee is switched off unless this is exactly "true". Linking workers and previewing a batch never need it.
# Keep it off (or unset) until the sandbox tests pass and Jasil approves; production is a separate decision.
EVEREE_PAYMENTS_ENABLED=…
# Live (production) payments also need this to be exactly "true". Leave it unset until Jasil approves going live in chat.
EVEREE_PRODUCTION_PAYMENTS_APPROVED=…
# Lets a signed-in Local driver start Everee onboarding from NASA (issue #242). Off unless this is exactly "true". Leave it off until the
# owners approve; switching it on for production is a separate approval.
EVEREE_DRIVER_ONBOARDING_ENABLED=…
# The hard gate (issue #242, PR B): with BOTH this and the setting above exactly "true", a Local driver whose Everee onboarding is not complete cannot
# work and cannot be paid by any method (Cash in Hand included). Before switching it on, review the active routes and outstanding payouts with the
# owners, and give every active Local driver a verified link (see the journal of PR B). Off by default. Production needs the owners' approval.
EVEREE_ONBOARDING_ENFORCED=…
# Leave empty to use https://api.everee.com. Only tests use another address.
EVEREE_API_BASE_URL=…
# The signing key of the webhook endpoint you create in Everee (Settings > Integrations hub > Manage Everee API > Webhooks). It is shown
# once, when the webhook is created. Sandbox and production endpoints have different keys. A secret: only in the real .env.
# Everee calls POST /webhooks/everee on this server; it needs a public HTTPS address (for local tests, a tunnel).
EVEREE_WEBHOOK_SIGNING_KEY=…

# NASA Insights connector for Claude (issue #220). Off unless MCP_ENABLED is exactly "true". Placeholders only.
MCP_ENABLED=
# Public HTTPS address of this backend, origin only (no path), e.g. https://api.your-domain.example
MCP_PUBLIC_BASE_URL=
# Optional. Extra Host header values to accept (comma separated), if a proxy changes the host.
MCP_ALLOWED_HOSTS=
# Optional. Origins allowed on /mcp (default: https://claude.ai,https://claude.com).
MCP_ALLOWED_ORIGINS=
# Optional. "true" also accepts Claude Code's local redirect. Leave empty for claude.ai, Desktop and mobile.
MCP_ALLOW_CLAUDE_CODE_LOOPBACK=

# NASA Insights reporting database (issue #220). A SEPARATE read-only login that can only read the `reporting` views.
# Without all four required settings the data tools are off; the application's DB_* login is never used for reports.
REPORTING_DB_HOST=
REPORTING_DB_NAME=
REPORTING_DB_USER=
REPORTING_DB_PASSWORD=
# Optional: REPORTING_DB_PORT (5432), REPORTING_DB_SSL ("true" for TLS; the server certificate is verified),
# REPORTING_DB_SSL_CA (the CA certificate as PEM text if it is not publicly trusted), REPORTING_DB_POOL_MAX (1 to 5, default 3),
# REPORTING_DB_TIMEOUT_MS (query time limit, 1000 to 30000, default 10000)
REPORTING_DB_PORT=
REPORTING_DB_SSL=
REPORTING_DB_POOL_MAX=
REPORTING_DB_TIMEOUT_MS=
