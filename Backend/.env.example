# Names of the settings the backend reads. Copy this file to `.env` and fill in the values.
# Never commit a real `.env`, and never put real values in this file.

PORT=
NODE_ENV=
FRONTEND_URL=

# What the logger prints: error, warn, info or debug. Default: info in production, debug elsewhere.
LOG_LEVEL=

# Number of proxies in front of the app: 0 if none, 1 behind a single hosting proxy.
# REQUIRED in production (the server will not start without a whole number). Login limits use the client
# address, which is only correct when this matches reality.
TRUST_PROXY=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# Redis (keeps the list of revoked sign-in tokens)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Sign-in tokens. Use two DIFFERENT long random values.
# The server will not start if either is missing or if they are the same.
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Cloudinary (access code images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
