# Copy to .env for local runs. Values are examples only; real values belong in the EAS build profile.
# One of: development, preview, production
APP_ENV=development
# The hosted NASA web app the WebView loads (HTTPS required outside development)
NASA_WEB_ORIGIN=http://localhost:5173
# The NASA backend API the shell calls for token refresh and logout (HTTPS required outside development)
NASA_API_ORIGIN=http://localhost:5001
# Bundle identifier and Android package. Placeholder until the client's developer accounts exist.
NASA_APP_ID=com.example.nasalogistics
# Push notifications. Both are optional until the owner's Expo and Firebase accounts exist; without them the app
# works and push reports itself unavailable.
# The Expo project ID that owns the push credentials (created by `eas init`)
EAS_PROJECT_ID=
# Path to the Firebase google-services.json for Android push (an EAS secret file). Never commit the file.
GOOGLE_SERVICES_FILE=
